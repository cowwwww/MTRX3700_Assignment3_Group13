set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY image_translation_sad
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SDC_FILE image_translation_sad.sdc
# Data pins are virtual and clock pins are unassigned. Add real pins before board use.
set_instance_assignment -name VIRTUAL_PIN ON -to reset
set_instance_assignment -name VIRTUAL_PIN ON -to reference_write
set_instance_assignment -name VIRTUAL_PIN ON -to search_write
set_instance_assignment -name VIRTUAL_PIN ON -to start
set_instance_assignment -name VIRTUAL_PIN ON -to load_ready
set_instance_assignment -name VIRTUAL_PIN ON -to ready
set_instance_assignment -name VIRTUAL_PIN ON -to busy
set_instance_assignment -name VIRTUAL_PIN ON -to result_valid
set_instance_assignment -name VIRTUAL_PIN ON -to motion_valid
set_instance_assignment -name VIRTUAL_PIN ON -to at_search_boundary
set_instance_assignment -name VIRTUAL_PIN ON -to reference_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to search_address[*]
set_instance_assignment -name VIRTUAL_PIN ON -to reference_gray[*]
set_instance_assignment -name VIRTUAL_PIN ON -to search_gray[*]
set_instance_assignment -name VIRTUAL_PIN ON -to reference_frame_id[*]
set_instance_assignment -name VIRTUAL_PIN ON -to current_frame_id[*]
set_instance_assignment -name VIRTUAL_PIN ON -to dx[*]
set_instance_assignment -name VIRTUAL_PIN ON -to dy[*]
set_instance_assignment -name VIRTUAL_PIN ON -to best_sad[*]
set_instance_assignment -name VIRTUAL_PIN ON -to second_sad[*]
set_instance_assignment -name VIRTUAL_PIN ON -to reference_contrast[*]
set_instance_assignment -name VIRTUAL_PIN ON -to result_reference_id[*]
set_instance_assignment -name VIRTUAL_PIN ON -to result_current_id[*]
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/camera/camera_byte_capture.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/common/unsigned_divider.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/motor/motion_control.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/motor/uart_tx.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/navigation/distance_guard.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/navigation/junction_memory.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/navigation/navigation_fsm.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/reuse/cdc_mailbox.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/reuse/reset_sync.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/safety/safety_stop.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/top/camera_debug_display.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/top/robot_camera_system.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/top/robot_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/top/robot_system.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/vision/curve_fit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/vision/debug_overlay.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/vision/image_translation_sad.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/vision/line_detector.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/vision/vga_scanout.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/vision/video_framebuffer.sv
